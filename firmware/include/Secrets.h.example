#pragma once

/*
 * Copy to Secrets.h and fill in. Secrets.h is gitignored.
 *
 * Matches the SSM parameter /website/polaroid/device-secret.
 */

#define POLAROID_DEVICE_TOKEN "replace-me"

/*
 * Networks the device will join, strongest signal first rather than in listed
 * order. Put both homes here: the frame is set up in one and lives in the
 * other.
 */
namespace polaroid {

struct WifiNetwork {
    const char* ssid;
    const char* password;
};

inline constexpr WifiNetwork WIFI_NETWORKS[] = {
    {"your-ssid", "your-password"},
};

}  // namespace polaroid
